# Nix build outputs. `result` alone missed every suffixed out-link
# (`nix build -o result-ctl`, `.#tests -o result-tests`, ...), so those got
# picked up by `git add -A` and committed as symlinks into /nix/store.
result
result-*
doctests/outputs/*
!doctests/outputs/*.md

# Generated build-info header (staged into src/ by flake.nix at build time)
src/logos_build_info.h
